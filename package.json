{
  "name": "trading-bot",
  "version": "1.0.0",
  "description": "Price Action based crypto trading bot for Binance Spot Testnet",
  "type": "module",
  "scripts": {
    "dev": "npx tsx src/index.ts",
    "dry-run": "npx tsx src/index.ts --dry-run",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "ccxt": "^4.4.0",
    "dotenv": "^16.4.0",
    "winston": "^3.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
