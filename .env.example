# ══════════════════════════════════════════════════
# Binance Spot Testnet API Credentials
# https://testnet.binance.vision adresinden oluştur
# SADECE Spot İşlem yetkisi — Çekim yetkisi KAPALI
# ══════════════════════════════════════════════════

# Ağ Seçimi: 'live', 'testnet' veya 'demo'
NETWORK=testnet

# Piyasa Tipi: 'spot' veya 'futures'
MARKET_TYPE=futures
FUTURES_LEVERAGE=20

BINANCE_API_KEY=your_api_key_here
BINANCE_SECRET=your_secret_here

# ══════════════════════════════════════════════════
# Trading Parameters (Multi-Pair)
# ══════════════════════════════════════════════════

# Tier 1 + Tier 2 Majör Çiftler (virgülle ayrılmış)
# Yüksek likidite, düşük spread — Price Action için ideal
TRADING_PAIRS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,AVAX/USDT,LINK/USDT,XRP/USDT,LTC/USDT,XLM/USDT,NEO/USDT,BCH/USDT,TRX/USDT,ETC/USDT,DOGE/USDT,FXS/USDT,BULLA/USDT,LSK/USDT,SYN/USDT,BR/USDT,AVA/USDT
# Kalan Pariteler (Yedek/Sonraki Kullanım İçin):
# AKE/USDT,POWER/USDT,AIN/USDT,RDNT/USDT,HEI/USDT,USELESS/USDT,ONE/USDT,REZ/USDT,COTI/USDT,SCRT/USDT,GRIFFAIN/USDT,SKYAI/USDT,SOLV/USDT,MAGMA/USDT,ON/USDT,4/USDT,SLERF/USDT,SOPH/USDT,ARB/USDT,DASH/USDT,ZEC/USDT,ZIL/USDT,VVV/USDT,UNI/USDT,CROSS/USDT,VELVET/USDT,1000BONK/USDT,RAYSOL/USDT,CHILLGUY/USDT,NEAR/USDT,ZEN/USDT,KOMA/USDT,ENA/USDT,MINA/USDT

# Risk yönetimi
RISK_PER_TRADE_PCT=2            # İşlem başına kasa yüzdesi riski
MAX_DAILY_LOSS_PCT=3            # Günlük maksimum kayıp yüzdesi (circuit breaker)
MAX_CONSECUTIVE_LOSSES=3        # Arka arkaya maksimum stop-loss sayısı
CIRCUIT_BREAKER_COOLDOWN_HOURS=4 # Şalter atarsa bekleme süresi (saat)
MIN_SL_PCT=0.008                # Minimum Stop-Loss yüzdesi (noise filtreleme)

# R:R hedefleri
MIN_RR_RATIO=2.0                # Minimum Risk:Reward oranı
TP1_RR=2                        # TP1 R:R seviyesi (%50 pozisyon)
TP2_RR=3                        # TP2 R:R seviyesi (kalan %50)

# Zaman dilimleri
HTF_TIMEFRAME=1h                # Yüksek zaman dilimi (trend filtresi)
LTF_TIMEFRAME=5m               # Düşük zaman dilimi (giriş sinyalleri)

# Kurumsal Filtreler (Institutional Filters)
ADX_PERIOD=15                   # ADX hesaplama periyodu
ADX_THRESHOLD=20                # İşleme girmek için gereken minimum ADX momentumu
TZ=Europe/Istanbul              # Killzone saat dilimi

# Komisyon ve kayma
MAKER_FEE_PCT=0.02              # Spot %0.1, Futures %0.02
TAKER_FEE_PCT=0.05              # Spot %0.1, Futures %0.05
SLIPPAGE_TICKS=2                # Tahmini fiyat kayması (tick sayısı)

# ══════════════════════════════════════════════════
# Sistem Ayarları
# ══════════════════════════════════════════════════

# Ses Bildirimleri (true/false) — Terminalde işlem açıldığında/kapandığında ses çalmasını engeller
ENABLE_SOUND=false
